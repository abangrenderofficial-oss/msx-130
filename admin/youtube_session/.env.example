# EXAMPLE ONLY. Copy as .env locally. Never commit the real .env.
# Public origin MUST have TLS from a trusted reverse proxy.
MUSIX_ADMIN_PUBLIC_ORIGIN=https://musix-admin.example.invalid
MUSIX_ADMIN_PASSWORD_SCRYPT=REPLACE_WITH_BOOTSTRAP_OUTPUT
MUSIX_ADMIN_TOTP_SECRET=REPLACE_WITH_BOOTSTRAP_OUTPUT
MUSIX_WORKER_SECRET=REPLACE_WITH_BOOTSTRAP_OUTPUT
# Must be an encrypted persistent host mount (LUKS/managed disk).
MUSIX_ENCRYPTED_VAULT_DIR=/mnt/encrypted-musix-youtube
# Google password and cookies are never needed here.
