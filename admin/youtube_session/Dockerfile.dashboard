FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv/session
RUN pip install --no-cache-dir aiohttp==3.14.3 && \
    useradd --create-home --uid 10001 --shell /usr/sbin/nologin admin && \
    mkdir -p /srv/novnc /state && chown -R admin:admin /state /srv/novnc
COPY --chown=admin:admin admin/youtube_session/ /srv/session/
USER admin
EXPOSE 8765
CMD ["python", "dashboard_server.py"]
