FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DISPLAY=:99
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium xvfb x11vnc novnc websockify ca-certificates fonts-liberation \
    && rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir aiohttp==3.14.3 "playwright>=1.56,<2" && \
    useradd --create-home --uid 10002 --shell /bin/sh browser && \
    mkdir -p /vault /srv/session && \
    chown -R browser:browser /vault /srv/session
WORKDIR /srv/session
COPY --chown=browser:browser admin/youtube_session/worker.py /srv/session/worker.py
COPY --chown=browser:browser admin/youtube_session/entrypoint.worker.sh /srv/session/entrypoint.worker.sh
RUN chmod +x /srv/session/entrypoint.worker.sh
USER browser
EXPOSE 8787 6080
CMD ["/srv/session/entrypoint.worker.sh"]
