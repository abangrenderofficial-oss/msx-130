# ADD THESE ENV VARS TO THE EXISTING MUSIX BOT HOSTING DEPLOYMENT.
# Default disabled: existing Telegram cache, yt-dlp, cookies, queue and PO
# token pipeline remain unchanged.
HOME_WORKER_ENABLED=false
HOME_WORKER_API_TOKEN=REPLACE_WITH_NEW_RANDOM_64_CHAR_TOKEN
HOME_WORKER_TIMEOUT_SECONDS=90
# The home PC uses the existing public HTTPS Musix admin website.
# No special DB credentials are needed on the home PC.
