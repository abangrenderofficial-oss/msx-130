# WINDOWS HOME WORKER ONLY. Copy to .env, NEVER commit .env.
MUSIX_PUBLIC_URL=https://YOUR-MUSIX-DOMAIN.apps.bot-hosting.cloud
HOME_WORKER_API_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_64_CHAR_TOKEN_AS_BOT_HOSTING
BOT_TOKEN=REPLACE_WITH_SAME_MUSIX_BOT_TOKEN
# Private staging channel/chat where the bot is an admin and may send audio.
# NOT the user's private chat or a /connectadminmusic monitor group.
STAGING_CHAT_ID=-1000000000000
HOME_WORKER_ID=windows-home
HOME_WORKER_POLL_SECONDS=6
HOME_MIN_YOUTUBE_DELAY_SECONDS=8
HOME_MAX_JOBS_PER_HOUR=30
HOME_MAX_CONCURRENT_JOBS=1
HOME_BOT_CHECK_COOLDOWN_SECONDS=600
HOME_MAX_DURATION_SECONDS=900
HOME_MAX_AUDIO_MB=49
HOME_MAX_SOURCE_MB=120
# Explicitly OFF for the residential-IP experiment.
COOKIES_PATH=
HOME_ENABLE_DENO=false
HOME_ENABLE_REMOTE_EJS=false
